NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# Local/preview normally use sk_test_... and whsec_... from a Stripe test-mode webhook.
# Vercel Production must use sk_live_... and the live webhook signing secret.
# Do not commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: only needed if a client-side Stripe.js integration is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

ANTHROPIC_API_KEY=
LEAD_UNSUBSCRIBE_SECRET=
RESEND_API_KEY=
AMG_EMAIL_FROM=
AMG_OPERATIONS_FROM=
AMG_REPLY_TO=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Comma-separated E.164 numbers that get an SMS the moment a public support
# request or contact inquiry lands. Unset = no SMS, emails still send.
AMG_LEAD_ALERT_SMS_TO=

PORTAL_BOOTSTRAP_ADMIN_EMAIL=
PORTAL_BOOTSTRAP_CLIENT_EMAIL=
PORTAL_BOOTSTRAP_CREW_EMAIL=
PORTAL_BOOTSTRAP_PARTNER_EMAIL=

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main
WEBSITE_EDITOR_ENABLED=true

# Shared secret for the FlightWall LED display bridge (GET /api/flightwall/summary).
# Generate a long random value (e.g. `openssl rand -hex 32`); the device sends it
# as `Authorization: Bearer <token>`. Endpoint is disabled while unset.
FLIGHTWALL_API_TOKEN=your-token-here

# Comma-separated public IPs allowed to open /ops/flightwall (the browser ops
# dashboard) without logging in — e.g. the house network. Anywhere else falls
# back to the normal portal admin login. Home internet IPs are usually
# DYNAMIC and rotate periodically; if the dashboard unexpectedly starts asking
# for login, check whattismyip and update this value in Vercel.
FLIGHTWALL_TRUSTED_IPS=

# Pilot Health / Oura (private single-owner workspace). All four are
# SERVER-ONLY — never add a NEXT_PUBLIC_ prefix. The redirect URI must exactly
# match the one registered in the Oura developer console
# (https://www.amgaviationgroup.com/api/pilot-health/oura/callback in
# production). The encryption key must be 32 random bytes, base64-encoded
# (`openssl rand -base64 32`); rotating it invalidates stored tokens and
# requires reconnecting Oura.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
OURA_TOKEN_ENCRYPTION_KEY=
