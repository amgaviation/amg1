NEXT_PUBLIC_SUPABASE_URL=https://vsynqnqlouvphiniqaiy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe local/test-mode placeholders. Do not put live keys in preview/local
# unless AMG intentionally wants live billing in that environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional notification providers. Missing credentials suppress external delivery safely.
RESEND_API_KEY=
AMG_EMAIL_FROM=
AMG_OPERATIONS_FROM=
AMG_REPLY_TO=
# Legacy aliases are still supported:
# EMAIL_FROM_ADDRESS=
# EMAIL_REPLY_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Comma-separated E.164 numbers that get an SMS the moment a public support
# request or contact inquiry lands. Unset = no SMS, emails still send.
AMG_LEAD_ALERT_SMS_TO=
NOTIFICATION_WEBHOOK_SECRET=

# Pilot Health / Oura (private single-owner workspace). Server-only; no
# NEXT_PUBLIC_ prefix. Local OAuth testing needs a locally registered redirect
# URI in the Oura console (e.g. http://localhost:3000/api/pilot-health/oura/callback)
# — leave OURA_REDIRECT_URI empty locally to fall back to the request origin.
# Key: `openssl rand -base64 32`.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
OURA_TOKEN_ENCRYPTION_KEY=
